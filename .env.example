# Ollama connection
OLLAMA_HOST=http://localhost:11434

# Models (must be pulled in Ollama: `ollama pull <name>`)
TEXT_MODEL=qwen3.5:4b
VISION_MODEL=qwen3-vl:8b

# Embeddings (downloaded from Hugging Face on first run)
EMBED_MODEL=all-MiniLM-L6-v2

# Retrieval
RAG_TOP_K=4
RRF_K=60

# Reflection
ENABLE_REFLECTION=true
MAX_REFLECTIONS=1

# Observability (optional, leave blank to disable Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
