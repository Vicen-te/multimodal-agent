# LLM provider: "ollama" (local, default), "gemini" (hosted Google API), or
# "openai" (OpenAI or any OpenAI-compatible API: Groq, OpenRouter, Mistral...)
LLM_PROVIDER=ollama

# Ollama connection (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Models (must be pulled in Ollama: `ollama pull <name>`)
TEXT_MODEL=qwen3.5:4b
VISION_MODEL=qwen3-vl:8b

# Google Gemini (used when LLM_PROVIDER=gemini) -- free key from aistudio.google.com
GOOGLE_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# OpenAI-compatible API (used when LLM_PROVIDER=openai); the base URL picks the
# provider, e.g. https://api.groq.com/openai/v1 or https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embeddings (downloaded from Hugging Face on first run)
EMBED_MODEL=all-MiniLM-L6-v2

# Retrieval
RAG_TOP_K=4
RRF_K=60

# Reflection
ENABLE_REFLECTION=true
MAX_REFLECTIONS=1

# Observability (optional, leave blank to disable Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
